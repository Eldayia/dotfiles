# --- CONFIGURATION BAT ---
# Cat avec coloration syntaxique

# Thème
--theme="TwoDark"

# Style (numéros de lignes, modifications Git, header)
--style="numbers,changes,header,grid"

# Pagination automatique si contenu trop long
--paging=auto

# Afficher les caractères non imprimables
--show-all

# Wrapper pour less
--pager="less -FR"

# Envelopper les lignes longues
--wrap=auto

# Mapper les extensions de fichiers
--map-syntax "*.conf:INI"
--map-syntax ".ignore:Git Ignore"
--map-syntax "*.nix:Nix"

# Italique (nécessite un terminal qui le supporte)
--italic-text=always

# Nombre de tabs
--tabs=4
