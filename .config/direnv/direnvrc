# --- DIRENVRC ---
# Fonctions helper pour direnv

# Helper pour charger Nix
use_nix() {
    if [ -f "shell.nix" ]; then
        eval "$(nix-shell --run "direnv dump")"
    elif [ -f "default.nix" ]; then
        eval "$(nix-shell --run "direnv dump")"
    fi
}

# Helper pour charger flake
use_flake() {
    watch_file flake.nix
    watch_file flake.lock
    eval "$(nix print-dev-env --profile "$(direnv_layout_dir)/flake-profile")"
}

# Helper pour Python virtualenv
layout_python() {
    local python=${1:-python3}
    [[ $# -gt 0 ]] && shift
    unset PYTHONHOME
    if [[ -n $VIRTUAL_ENV ]]; then
        VIRTUAL_ENV=$(realpath "${VIRTUAL_ENV}")
    else
        local python_version
        python_version=$("$python" -c "import platform; print(platform.python_version())")
        if [[ -z $python_version ]]; then
            log_error "Could not detect Python version"
            return 1
        fi
        VIRTUAL_ENV=$(direnv_layout_dir)/python-$python_version
    fi
    export VIRTUAL_ENV
    if [[ ! -d $VIRTUAL_ENV ]]; then
        log_status "no venv found; creating $VIRTUAL_ENV"
        "$python" -m venv "$VIRTUAL_ENV"
    fi
    PATH_add "$VIRTUAL_ENV/bin"
}

# Helper pour Node.js
layout_node() {
    local node_version=${1:-lts}
    local node_dir=$HOME/.local/share/direnv/node-$node_version

    if [[ ! -d $node_dir ]]; then
        log_status "Installing Node.js $node_version"
        mkdir -p "$node_dir"
    fi

    export NODE_VERSIONS=$node_dir
    export PATH=$NODE_VERSIONS/bin:$PATH
}
