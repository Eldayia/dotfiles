# --- CONFIGURATION GHOSTTY ---
# Terminal moderne ultra-rapide

# --- POLICE ---
font-family = "JetBrainsMono Nerd Font"
font-size = 11
font-feature = -calt

# --- THÈME (Nord) ---
background = 2e3440
foreground = d8dee9
cursor-color = 88c0d0
selection-background = 4c566a
selection-foreground = d8dee9

# Couleurs normales
palette = 0=#3b4252
palette = 1=#bf616a
palette = 2=#a3be8c
palette = 3=#ebcb8b
palette = 4=#81a1c1
palette = 5=#b48ead
palette = 6=#88c0d0
palette = 7=#e5e9f0

# Couleurs brillantes
palette = 8=#4c566a
palette = 9=#bf616a
palette = 10=#a3be8c
palette = 11=#ebcb8b
palette = 12=#81a1c1
palette = 13=#b48ead
palette = 14=#8fbcbb
palette = 15=#eceff4

# --- FENÊTRE ---
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-decoration = true

# Opacity
background-opacity = 0.95
background-blur-radius = 20

# --- CURSEUR ---
cursor-style = block
cursor-style-blink = true

# --- SHELL ---
shell-integration = true
shell-integration-features = cursor,sudo,title

# --- COPIER/COLLER ---
copy-on-select = false
clipboard-read = allow
clipboard-write = allow

# --- SOURIS ---
mouse-hide-while-typing = true

# --- SCROLLBACK ---
scrollback-limit = 10000

# --- RACCOURCIS CLAVIER ---
# Les raccourcis sont gérés par Ghostty automatiquement
# Ctrl+Shift+C/V pour copier/coller
# Ctrl+Shift+T pour nouveau tab
# Etc.

# --- PERFORMANCE ---
# Ghostty est déjà optimisé par défaut

# --- SUPPORT WAYLAND ---
# Ghostty détecte automatiquement Wayland
gtk-titlebar = false
