# --- CONFIGURATION I3 COMPLETE ---
# Basée sur la configuration Hyprland existante

# Modificateur principal (Ctrl = Mod4 sous i3, mais on utilise Mod1 pour Alt ou Mod4 pour Super)
# Pour correspondre à CTRL dans Hyprland, on va utiliser des bindings directs avec Control
set $mod Mod1

# Police pour les titres de fenêtres
font pango:monospace 10

# Définir les programmes
set $terminal warp-terminal
set $terminal2 kitty
set $fileManager nautilus
set $menu dmenu_run

# --- DÉMARRAGE AUTOMATIQUE ---
exec --no-startup-id dunst
exec --no-startup-id i3status
# exec --no-startup-id waybar  # Désactivé par défaut comme dans Hyprland

# --- APPARENCE GÉNÉRALE ---
# Espaces entre fenêtres (gaps)
gaps inner 5
gaps outer 10

# Bordures
default_border pixel 2
default_floating_border pixel 2

# Couleurs des bordures (adaptation des couleurs Hyprland)
# col.active_border = rgba(33ccffee) rgba(00ff99ee)
client.focused          #33ccff #33ccff #ffffff #00ff99   #33ccff
client.focused_inactive #595959 #595959 #ffffff #595959   #595959
client.unfocused        #595959 #595959 #888888 #595959   #595959
client.urgent           #ff0000 #ff0000 #ffffff #ff0000   #ff0000

# --- RACCOURCIS CLAVIER (adaptation Hyprland avec Ctrl) ---

# Applications (Ctrl comme dans Hyprland)
bindsym Control+t exec warp-terminal
bindsym Control+q exec kitty
bindsym Control+b exec microsoft-edge
bindsym Control+e exec kitty -e yazi
bindsym Control+space exec dmenu_run
bindsym Control+w exec i3status

# Scripts de diagnostic (comme Hyprland)
bindsym Control+d exec bash ~/.config/i3/debug-env.sh
bindsym Control+Shift+d exec bash ~/.config/i3/check-graphics.sh

# Gestion des fenêtres (Ctrl comme dans Hyprland)
bindsym Control+c kill
bindsym Control+m exec "i3-msg exit"
bindsym Control+v floating toggle
bindsym Control+j layout toggle split

# Focus avec flèches (Ctrl + flèches comme dans Hyprland)
bindsym Control+Left focus left
bindsym Control+Right focus right
bindsym Control+Up focus up
bindsym Control+Down focus down

# Déplacement de fenêtres avec flèches (Ctrl+Shift + flèches)
bindsym Control+Shift+Left move left
bindsym Control+Shift+Right move right
bindsym Control+Shift+Up move up
bindsym Control+Shift+Down move down

# Workspaces 1-5 (Ctrl + numéro comme dans Hyprland)
bindsym Control+1 workspace number 1
bindsym Control+2 workspace number 2
bindsym Control+3 workspace number 3
bindsym Control+4 workspace number 4
bindsym Control+5 workspace number 5

# Déplacer vers workspace (Ctrl+Shift + numéro comme dans Hyprland)
bindsym Control+Shift+1 move container to workspace number 1
bindsym Control+Shift+2 move container to workspace number 2
bindsym Control+Shift+3 move container to workspace number 3
bindsym Control+Shift+4 move container to workspace number 4
bindsym Control+Shift+5 move container to workspace number 5

# Redimensionnement de fenêtres (Mod1 + r pour entrer en mode resize)
bindsym $mod+r mode "resize"
mode "resize" {
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # Retour au mode normal avec Escape ou Enter
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym Control+c mode "default"
}

# Drag fenêtres avec souris (comme Hyprland avec Ctrl)
floating_modifier Control

# Recharger/Redémarrer i3
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# --- BAR (i3status) ---
bar {
        status_command i3status
        position top

        colors {
                background #1a1a1a
                statusline #ffffff
                separator  #666666

                focused_workspace  #33ccff #33ccff #ffffff
                active_workspace   #595959 #595959 #ffffff
                inactive_workspace #1a1a1a #1a1a1a #888888
                urgent_workspace   #ff0000 #ff0000 #ffffff
        }
}
