# --- CONFIGURATION i3 COMPLETE ---
# Basée sur hyprland.conf pour cohérence des raccourcis
# Configuration optimisée pour VMware

# =====================================
# 1. VARIABLES & PROGRAMMES
# =====================================

# Modificateur principal
# Note: Utilisation de Ctrl directement dans les bindings pour correspondre à Hyprland
set $mod Mod1

# Police pour les titres de fenêtres et la barre
font pango:DejaVu Sans Mono, FontAwesome 10

# Programmes (comme dans Hyprland)
set $terminal warp-terminal
set $terminal2 kitty
set $fileManager nautilus
set $menu dmenu_run

# =====================================
# 2. DÉMARRAGE AUTOMATIQUE
# =====================================

# Services essentiels
exec --no-startup-id dunst
# exec --no-startup-id picom  # Compositeur pour transparence/ombres (optionnel)

# Fond d'écran (optionnel)
# exec --no-startup-id feh --bg-scale ~/wallpaper.jpg

# =====================================
# 3. APPARENCE GÉNÉRALE
# =====================================

# Espaces entre fenêtres (gaps - comme Hyprland: inner=5, outer=10)
gaps inner 5
gaps outer 10

# Bordures (2px comme dans Hyprland)
default_border pixel 2
default_floating_border pixel 2

# Masquer les bordures si une seule fenêtre
hide_edge_borders smart

# =====================================
# 4. COULEURS (adaptation Hyprland)
# =====================================

# Couleurs des bordures
# Hyprland: active=#33ccff, inactive=#595959
# Format i3: border background text indicator child_border
client.focused          #33ccff #33ccff #ffffff #00ff99   #33ccff
client.focused_inactive #595959 #595959 #ffffff #595959   #595959
client.unfocused        #595959 #595959 #888888 #595959   #595959
client.urgent           #ff0000 #ff0000 #ffffff #ff0000   #ff0000
client.placeholder      #000000 #0c0c0c #ffffff #000000   #0c0c0c
client.background       #ffffff

# =====================================
# 5. RACCOURCIS CLAVIER
# =====================================

# --- APPLICATIONS (Ctrl comme Hyprland: $mainMod = CTRL) ---
bindsym Control+t exec --no-startup-id warp-terminal
bindsym Control+q exec --no-startup-id kitty
bindsym Control+b exec --no-startup-id microsoft-edge
bindsym Control+e exec --no-startup-id kitty -e yazi
bindsym Control+space exec --no-startup-id dmenu_run -i -fn 'DejaVu Sans Mono-10'

# Lancer i3bar manuellement (équivalent waybar)
bindsym Control+w exec --no-startup-id i3-msg restart

# Scripts de diagnostic (comme Hyprland)
bindsym Control+d exec --no-startup-id bash ~/.config/i3/debug-env.sh
bindsym Control+Shift+d exec --no-startup-id bash ~/.config/i3/check-graphics.sh

# --- GESTION DES FENÊTRES (Ctrl comme Hyprland) ---
bindsym Control+c kill
bindsym Control+m exec "i3-msg exit"
bindsym Control+v floating toggle
bindsym Control+p focus parent
bindsym Control+j layout toggle split

# Fullscreen
bindsym Control+f fullscreen toggle

# --- FOCUS (Flèches - comme Hyprland) ---
bindsym Control+Left focus left
bindsym Control+Right focus right
bindsym Control+Up focus up
bindsym Control+Down focus down

# --- DÉPLACEMENT DE FENÊTRES (Ctrl+Shift + flèches) ---
bindsym Control+Shift+Left move left 30px
bindsym Control+Shift+Right move right 30px
bindsym Control+Shift+Up move up 30px
bindsym Control+Shift+Down move down 30px

# --- WORKSPACES 1-5 (Ctrl + numéro comme Hyprland) ---
bindsym Control+1 workspace number 1
bindsym Control+2 workspace number 2
bindsym Control+3 workspace number 3
bindsym Control+4 workspace number 4
bindsym Control+5 workspace number 5

# Workspaces supplémentaires (6-10)
bindsym Control+6 workspace number 6
bindsym Control+7 workspace number 7
bindsym Control+8 workspace number 8
bindsym Control+9 workspace number 9
bindsym Control+0 workspace number 10

# --- DÉPLACER VERS WORKSPACE (Ctrl+Shift + numéro) ---
bindsym Control+Shift+1 move container to workspace number 1
bindsym Control+Shift+2 move container to workspace number 2
bindsym Control+Shift+3 move container to workspace number 3
bindsym Control+Shift+4 move container to workspace number 4
bindsym Control+Shift+5 move container to workspace number 5

# Déplacer vers workspaces supplémentaires
bindsym Control+Shift+6 move container to workspace number 6
bindsym Control+Shift+7 move container to workspace number 7
bindsym Control+Shift+8 move container to workspace number 8
bindsym Control+Shift+9 move container to workspace number 9
bindsym Control+Shift+0 move container to workspace number 10

# --- LAYOUTS ---
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Split horizontal/vertical
bindsym $mod+h split h
bindsym $mod+v split v

# =====================================
# 6. REDIMENSIONNEMENT
# =====================================

# Mode resize (Mod1 + r pour entrer)
bindsym $mod+r mode "resize"

mode "resize" {
        # Redimensionnement avec les flèches
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # Retour au mode normal
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym Control+c mode "default"
}

# =====================================
# 7. SOURIS
# =====================================

# Drag fenêtres avec souris (Ctrl + clic gauche = déplacer)
floating_modifier Control

# Bindings souris (comme Hyprland)
# Control + clic gauche = déplacer
# Control + clic droit = redimensionner

# =====================================
# 8. GESTION i3
# =====================================

# Recharger la configuration
bindsym $mod+Shift+c reload

# Redémarrer i3 (préserve la session)
bindsym $mod+Shift+r restart

# Quitter i3
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Voulez-vous quitter i3?' -B 'Oui' 'i3-msg exit'"

# =====================================
# 9. BAR (i3bar + i3status)
# =====================================

bar {
        status_command i3status
        position top

        # Police de la barre
        font pango:DejaVu Sans Mono, FontAwesome 10

        # Séparateur entre modules
        separator_symbol " | "

        # Couleurs de la barre (adaptation Hyprland)
        colors {
                background #1a1a1a
                statusline #ffffff
                separator  #666666

                # workspace       border  backgr  text
                focused_workspace  #33ccff #33ccff #ffffff
                active_workspace   #595959 #595959 #ffffff
                inactive_workspace #1a1a1a #1a1a1a #888888
                urgent_workspace   #ff0000 #ff0000 #ffffff
                binding_mode       #00ff99 #00ff99 #000000
        }
}

# =====================================
# 10. RÈGLES DE FENÊTRES
# =====================================

# Fenêtres flottantes par défaut pour certaines applications
for_window [class="Pavucontrol"] floating enable
for_window [class="Arandr"] floating enable
for_window [class="Lxappearance"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable

# Centre les fenêtres flottantes
for_window [floating] move position center

# =====================================
# 11. MODES SUPPLÉMENTAIRES
# =====================================

# Mode système (verrouillage, suspension, etc.)
set $mode_system Système: (l) lock, (e) logout, (s) suspend, (r) reboot, (p) poweroff
mode "$mode_system" {
    bindsym l exec --no-startup-id i3lock -c 000000, mode "default"
    bindsym e exec --no-startup-id i3-msg exit, mode "default"
    bindsym s exec --no-startup-id systemctl suspend, mode "default"
    bindsym r exec --no-startup-id systemctl reboot, mode "default"
    bindsym p exec --no-startup-id systemctl poweroff, mode "default"

    # Retour au mode normal
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+Escape mode "$mode_system"
