# Secrets
*.pem
*.key
*credentials*
*secret*
*token*

# Temporary
*.swp
*.swo
*.tmp
*~
.DS_Store

# Logs
*.log

# Machine generated / cache
.cache/
.local/state/

# Backup files
*.bak
*.backup
*.backup-*

# DMS plugin sources and runtime history (restored from lockfile/defaults)
/dms/.config/DankMaterialShell/plugins/
/dms/.config/DankMaterialShell/plugin_settings.json
__pycache__/

# Colors regenerated by DMS/matugen on every wallpaper or theme change
/gtk/.config/gtk-3.0/dank-colors.css
/gtk/.config/gtk-4.0/dank-colors.css
/qt/.config/qt6ct/colors/matugen.conf
/vesktop/.config/vesktop/themes/dank-discord.css
/dms/.config/DankMaterialShell/zen.css
