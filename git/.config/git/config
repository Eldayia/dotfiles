[user]
	name = Eldayia
	email = eldayia@gmail.com
[alias]
	dft = !git -c diff.external=difft diff
[include]
	path = themes/catppuccin.gitconfig
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	features = catppuccin-mocha
	navigate = true
	line-numbers = true
	side-by-side = false
	hyperlinks = true
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
