#!/usr/bin/env python3
"""Calculate SHA-256 for selected local files without changing them."""
import os
import subprocess
import sys
from urllib.parse import urlsplit, unquote

if sys.argv[1:]:
    paths = [os.path.abspath(p) for p in sys.argv[1:]]
else:
    paths = []
    for uri in os.environ.get("NAUTILUS_SCRIPT_SELECTED_URIS", "").splitlines():
        parsed = urlsplit(uri)
        if parsed.scheme != "file" or parsed.netloc not in ("", "localhost"):
            subprocess.run(["notify-send", "SHA-256", "Sélectionne des fichiers locaux."], check=False)
            sys.exit(1)
        paths.append(unquote(parsed.path))
if not paths or any(not os.path.isfile(p) for p in paths):
    subprocess.run(["notify-send", "SHA-256", "Sélectionne un ou plusieurs fichiers, sans dossier."], check=False)
    sys.exit(1)
# Paths are separate arguments, never interpreted as shell commands.
subprocess.Popen(["ghostty", "--gtk-single-instance=false", "-e", "bash", "-c",
    'sha256sum -- "$@"; printf "\nAppuie sur Entrée pour fermer."; read -r',
    "nautilus-sha256", *paths], start_new_session=True)
