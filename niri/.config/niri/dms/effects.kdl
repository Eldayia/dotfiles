// ============================================================
// CUSTOM NIRI / DMS GLASS EFFECTS
// Keep this file OUTSIDE DMS-generated files.
// Include it AFTER the dms/*.kdl includes in config.kdl.
// ============================================================

// Global blur quality.
// 3 passes keeps GPU cost reasonable on a laptop; offset 4 gives
// a noticeably softer glass effect without pushing pass count higher.
blur {
    passes 3
    offset 4.0
    noise 0.015
    saturation 1.15
}

// Slightly airier layout and soft shadows.
layout {
    gaps 8

    shadow {
        on
        softness 28
        spread 3
        offset x=0 y=5
        draw-behind-window true
        color "#00000066"
    }
}

// Rounded glass for normal windows.
// Opaque applications remain visually opaque; apps such as Ghostty need
// their own background opacity configured separately.
window-rule {
    geometry-corner-radius 14
    clip-to-geometry true

    background-effect {
        blur true
        // Composite the real windows and layers below this surface.
        xray false
    }
}

// Floating windows get true blur of the actual content underneath them.
window-rule {
    match is-floating=true

    background-effect {
        blur true
        xray false
    }
}

// DMS windows (settings, special windows) should look like real glass.
window-rule {
    match app-id="^com\\.danklinux\\.dms$"

    background-effect {
        blur true
        xray false
    }
}

// DMS layer-shell surfaces: dashboard, launcher, control center,
// notifications, etc. Use true blur so windows below remain visible as blur.
layer-rule {
    match namespace="^dms:"

    background-effect {
        blur true
        xray false
    }
}

// Keep the bar on true blur so its transparency reflects the actual windows
// underneath it instead of only the wallpaper.
layer-rule {
    match namespace="^dms:bar$"

    background-effect {
        blur true
        xray false
    }
}

// DMS already owns a dedicated blurred-wallpaper/background layer.
// Avoid applying a second blur pass to these full-screen surfaces.
layer-rule {
    match namespace="^dms:blurwallpaper$"

    background-effect {
        blur false
        xray false
    }
}

layer-rule {
    match namespace="^dms:.*:background$"

    background-effect {
        blur false
        xray false
    }
}
