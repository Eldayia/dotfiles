[Unit]
Description=Open WebUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

WorkingDirectory=%h/.local/share/open-webui

Environment="DATA_DIR=%h/.local/share/open-webui/data"
Environment="OLLAMA_BASE_URL=http://127.0.0.1:11434"

# Ne jamais laisser une requête bloquer la file Ollama indéfiniment
Environment="AIOHTTP_CLIENT_TIMEOUT=600"
Environment="AIOHTTP_CLIENT_STREAM_IDLE_TIMEOUT=300"

ExecStart=/usr/bin/uvx --python 3.11 open-webui@latest serve --host 127.0.0.1 --port 8080

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
